#!/usr/bin/env python3
"""
Ultra-simple picks interface - just run 'python picks' or './picks'
"""
import sys
from datetime import datetime
from gregs_cbb_parser import GregsCBBParser
from vsin_scraper import VSINScraper
from odds_fetcher import OddsFetcher
from daily_picks_generator import DailyPicksGenerator


def main():
    """Get picks and display as simple list."""
    # Auto-fetch Greg's lines
    scraper = VSINScraper()

    if scraper.auto_update_check():
        file_path = scraper.fetch_daily_lines()
        if not file_path:
            file_path = scraper.get_latest_lines_path()
    else:
        file_path = scraper.get_latest_lines_path()

    if not file_path:
        print("❌ Could not get Greg's lines from VSIN")
        print("   Try manually downloading from: https://vsin.com/college-basketball/greg-petersons-daily-college-basketball-lines/")
        return

    # Parse
    parser = GregsCBBParser(file_path)
    games = parser.parse_all_sheets()

    if not games:
        print("❌ No games found in file")
        return

    # Get odds
    fetcher = OddsFetcher()
    sportsbook_data = fetcher.fetch_ncaab_odds('bet365')

    if not sportsbook_data:
        print("❌ Could not fetch sportsbook odds")
        print("   Check your API key in .env file")
        return

    # Generate picks with looser threshold (within 2 points of target)
    generator = DailyPicksGenerator(under_threshold=3.0, over_threshold=1.0)
    all_picks = generator.generate_picks(games, sportsbook_data)

    # Sort by absolute edge (biggest edges first)
    if all_picks:
        all_picks.sort(key=lambda x: abs(x['edge']), reverse=True)

    # Display
    if not all_picks:
        print(f"\n📅 {datetime.now().strftime('%B %d, %Y')}")
        print("❌ No picks today (no edges meet criteria)")
        print("\nStrategy: UNDER ≥5 below | OVER ≥3 above\n")
        return

    print(f"\n📅 {datetime.now().strftime('%B %d, %Y')} - CBB TOTALS PICKS\n")

    for i, pick in enumerate(all_picks, 1):
        edge = abs(pick['edge'])

        # Determine strength
        if pick['pick'] == 'UNDER' and edge >= 5.0:
            strength = "🔥 STRONG"
        elif pick['pick'] == 'OVER' and edge >= 3.0:
            strength = "🔥 STRONG"
        else:
            strength = "⚠️  CLOSE"

        pick_emoji = "⬇️" if pick['pick'] == 'UNDER' else "⬆️"

        # Format game time
        game_time_str = ""
        if pick.get('game_time'):
            try:
                import pytz
                # Parse ISO format time
                game_time_utc = datetime.fromisoformat(pick['game_time'].replace('Z', '+00:00'))
                # Convert to Central Time
                central = pytz.timezone('America/Chicago')
                game_time_cst = game_time_utc.astimezone(central)
                game_time_str = f" ({game_time_cst.strftime('%I:%M %p CST')})"
            except:
                pass

        print(f"{strength} {pick_emoji} {pick['pick']} {pick['sportsbook_total']:.1f} - {pick['matchup']}{game_time_str}")
        print(f"   Edge: {edge:.1f} pts | Greg: {pick['gregs_total']:.1f} | Book: {pick['sportsbook_total']:.1f}")
        if i < len(all_picks):
            print()

    print(f"\n{'─'*60}")
    print(f"🔥 STRONG = UNDER ≥5 below | OVER ≥3 above")
    print(f"⚠️  CLOSE = Within 2 pts of target (watch for line movement)")
    print(f"⬇️ = Under | ⬆️ = Over")
    print(f"{'─'*60}\n")


if __name__ == '__main__':
    main()
